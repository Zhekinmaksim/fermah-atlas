{
  "name": "fermah-atlas-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify:stills": "node scripts/render-stills.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "dev": "remotion studio",
    "render": "remotion render Week22 out/spotlight-week-22.mp4 --codec=h264 --crf=17",
    "render:vertical": "remotion render Week22Vertical out/spotlight-week-22-9x16.mp4 --codec=h264 --crf=17",
    "render:motion": "remotion render Motion out/fermah-atlas-motion.mp4 --codec=h264 --crf=17",
    "render:promo": "remotion render Promo out/fermah-atlas-45s.mp4 --codec=h264 --crf=17",
    "render:square": "remotion render Week22Square out/spotlight-week-22-1x1.mp4 --codec=h264 --crf=17",
    "still": "remotion still Promo out/frame.png --frame=260",
    "render:stats": "remotion render Stats20 out/atlas-stats-20s.mp4 --codec=h264 --crf=17",
    "render:stats:vertical": "remotion render Stats20Vertical out/atlas-stats-20s-9x16.mp4 --codec=h264 --crf=17",
    "render:stats:square": "remotion render Stats20Square out/atlas-stats-20s-1x1.mp4 --codec=h264 --crf=17"
  },
  "dependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/media-utils": "4.0.518",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
