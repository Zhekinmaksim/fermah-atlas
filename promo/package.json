{
  "name": "fermah-atlas-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && remotion compositions src/index.ts",
    "render": "remotion render Promo out/fermah-atlas-45s.mp4 --codec=h264 --crf=17",
    "render:square": "remotion render PromoSquare out/fermah-atlas-45s-1x1.mp4 --codec=h264 --crf=17",
    "render:vertical": "remotion render PromoVertical out/fermah-atlas-45s-9x16.mp4 --codec=h264 --crf=17",
    "still": "remotion still Promo out/frame.png --frame=260"
  },
  "dependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/media-utils": "4.0.518",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
